{
  "manifest_version": 3,
  "name": "Listen テキスト抽出ツール",
  "version": "1.0.1",
  "description": "Listenのページからテキストを抽出して表示・コピーするツールです。",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://listen.style/p/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://listen.style/*"
  ]
}
