{
  "manifest_version": 3,
  "name": "Listen テキスト抽出ツール",
  "version": "1.0",
  "description": "Listenのページからテキストを抽出して表示・コピーするツールです。",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://listen.style/p/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://listen.style/*"
  ]
}
