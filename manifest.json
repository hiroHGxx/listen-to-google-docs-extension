{
  "manifest_version": 3,
  "name": "Listen テキスト抽出ツール",
  "version": "1.0.2",
  "description": "Listenのページからテキストを抽出して表示・コピーするツールです。",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://listen.style/p/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://listen.style/*"
  ],
  "web_accessible_resources": [{
    "resources": ["content.js"],
    "matches": ["<all_urls>"]
  }]
}
